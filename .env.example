# Copy to .env.local. Leave both Supabase values empty to run in local demo mode.
# Both are PUBLIC values (the anon key is protected by Row Level Security).
# Never put the service-role key in any VITE_ variable: it would ship to every phone.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: any MapLibre style URL. Defaults to OpenFreeMap (free, no key).
VITE_MAP_STYLE_URL=
